<!doctype html>
<html lang="en">
  <head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f7f2ed">
    <script defer src="/assets/main.js"></script>
    <title>{{ title }}</title>
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="alternate" type="application/rss+xml" title="{{ site.title }}: Links" href="/links/feed.xml">
    <link rel="alternate" type="text/markdown" href="{{ page.url | markdownUrl }}">
    <link rel="stylesheet" type="text/css" href="/assets/main.css" />
    {%- if site.cloudflareAnalyticsToken %}
    <!-- Cloudflare Web Analytics: cookieless, no consent banner needed. -->
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ site.cloudflareAnalyticsToken }}"}'></script>
    {%- endif %}
	<!-- icons from https://heroicons.com -->
  </head>
  <body class="font-sans antialiased text-gray-900 leading-normal tracking-wider">
	<div class="md:w-3/5 md:mx-auto">
		{% include "_head.html" %}
		<div class="p-6">
			<main class="flex-auto content">
			{{ content | safe }}  
			</main>
		</div>
		{% include "_footer.html" %}
	</div>
  </body>
</html>


